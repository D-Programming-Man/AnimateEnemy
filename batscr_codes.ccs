}

// Starts an enemy with a random frame of animation
BYTECODE_34: {
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_ID_OFFSET)
	ASL
	ASL
	ASL
	CLC
	ADC_i (ANIM_TABLE_MAX_FRAME_OFFSET)
	TAX
	LDA_xl (ANIM_TABLE_ADDR)
	AND_i (0x00FF)
	DEC
	
	JSL (RandModA)
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

BYTECODE_35: {
	LDA_i ({short[0] ANIM_TABLE_ADDR})
	STA_d (PARSER_TEMP_VAR_1)
	LDA_i ({short[1] ANIM_TABLE_ADDR})
	STA_d (PARSER_TEMP_VAR_2)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_ID_OFFSET)
	ASL
	ASL
	ASL
	CLC
	ADC_i (ANIM_TABLE_MAX_FRAME_OFFSET)
	TAY
	
	LDA_dly (PARSER_TEMP_VAR_1)
	AND_i (0x00FF)
	DEC
	STA_d (PARSER_TEMP_VAR_3)

	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	INC
	CMP_d (PARSER_TEMP_VAR_3)
	BCC_a (Store_Frame_Count)
	BEQ_a (Store_Frame_Count)
	
Correct_Frame_Count:
	LDA_8 (0x00)
Store_Frame_Count:
	STA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}


BYTECODE_36: {
	LDA_i ({short[0] ANIM_TABLE_ADDR})
	STA_d (PARSER_TEMP_VAR_1)
	LDA_i ({short[1] ANIM_TABLE_ADDR})
	STA_d (PARSER_TEMP_VAR_2)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_ID_OFFSET)
	ASL
	ASL
	ASL
	CLC
	ADC_i (ANIM_TABLE_MAX_FRAME_OFFSET)
	TAY
	
	LDA_dly (PARSER_TEMP_VAR_1)
	AND_i (0x00FF)
	DEC
	STA_d (PARSER_TEMP_VAR_3)

	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	DEC
	CMP_8 (0xFF)
	BNE_a (Store_Frame_Count)
	
Correct_Frame_Count:
	LDA_d (PARSER_TEMP_VAR_3)
Store_Frame_Count:
	STA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}


BYTECODE_37: {
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)

	LDX_i (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PRIORITY_DRAW_BIT_ALL)
	LSR
	LSR
	LSR
	LSR
	TAY
	
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	TAX
	TYA
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}


BYTECODE_38: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	LDY_d (PARSER_BYTE_CODE_PARAM_1)
	CPY_i (0x00FF)
	BNE_a (Using_Register)
	
Using_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	AND_i (0x0003)
	ASL
	ASL
	ASL
	ASL
	STA_d (PARSER_TEMP_VAR_1)
	
Using_Register:
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	AND_i (0x0003)
	ASL
	ASL
	ASL
	ASL
	STA_d (PARSER_TEMP_VAR_1)
	
Store_Value:
	LDA_i (AE_SCRIPT_ATTRIBUTES_PRIORITY_DRAW_BIT_ALL)
	EOR_i (0xFFFF)
	STA_d (PARSER_TEMP_VAR_2)	// Make filter to focus on this setting's bit
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_d (PARSER_TEMP_VAR_2)	// Use that filter
	ORA_d (PARSER_TEMP_VAR_1)	// Then we set our settings
	STA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}


BYTECODE_39: {
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	
	LDA_dl (PARSER_BYTE_CODE_PARAM_1)
	AND_i (0x0003)
	ASL
	ASL
	ASL
	ASL
	STA_d (PARSER_TEMP_VAR_1)
	
