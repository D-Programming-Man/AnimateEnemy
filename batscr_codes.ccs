BYTECODE_59: {
	NOP
	NOP
	NOP
	
Return:
	JMP_l (Parser_Common_Return)
}


// Stops the enmey's script execution permenantly
BYTECODE_5A: {
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	ORA_8 (0x80)
	STA_x (AE_SCRIPT_SETTINGS_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Executes an ASM call to a routine using Result, Var0, and Var1 as A/X/Y respectively
// When routine is called back, stores the result of the routine into the Result/var0/var1 register
BYTECODE_5B: {
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	STA_a (RAM_JUMP_LO_ADDR)
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	STA_a (RAM_JUMP_HI_ADDR)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_VAR1_OFFSET)
	TAY
	LDA_x (AE_SCRIPT_VAR0_OFFSET)
	STA_d (PARSER_TEMP_VAR_3)
	LDA_x (AE_SCRIPT_RESULT_OFFSET)
	LDX_d (PARSER_TEMP_VAR_3)
	
	JSL (JSL_LongJump_00BC)
	PHY
	PHX
	
	REP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_RESULT_OFFSET)
	PLA
	STA_x (AE_SCRIPT_VAR0_OFFSET)
	PLA
	STA_x (AE_SCRIPT_VAR1_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
	
}

// Very similar to movscr_codes's b_unlock_text, although I'm not sure if this will work
// in the same way, but leaving this here to see if it does or not.
BYTECODE_5C: {
	SEP (0x20)
	LDA_8 (0x01)
	STA_a (0x9641)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Returns a random number, either 8bit or 16bit depending on the parameter
define RandModA = 0xC45F7B
BYTECODE_5D: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_3)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	BNE_a (Using_16Bit)
	
	STZ_d (PARSER_TEMP_VAR_1)
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	BRA_a (Get_Random_Number)
	
Using_16Bit:
	CMP_i (0x0002)
	BEQ_a (Rand_Limit)

	STZ_d (PARSER_TEMP_VAR_1)
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	BRA_a (Get_Random_Number)
	
Rand_Limit:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	STA_d (PARSER_TEMP_VAR_1)
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	
Get_Random_Number:
	JSL (RandModA)
	STA_d (PARSER_TEMP_VAR_2)
	
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Toggles the flying settings, 0 = Off, 1 = On
BYTECODE_5E: {
	STZ_d (PARSER_TEMP_VAR_1)

	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	AND_i (0x0001)
	BEQ_a (Turn_Off)
	
	LDA_i (AE_SCRIPT_SETTINGS_FLYING_BIT)
	STA_d (PARSER_TEMP_VAR_1)
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	ORA_d (PARSER_TEMP_VAR_1)
	STA_x (AE_SCRIPT_SETTINGS_OFFSET)
	BRA_a (Return)
	
Turn_Off:
	LDA_i (AE_SCRIPT_SETTINGS_FLYING_BIT)
	EOR_i (0xFFFF)
	STA_d (PARSER_TEMP_VAR_1)

	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_d (PARSER_TEMP_VAR_1)
	STA_x (AE_SCRIPT_SETTINGS_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Gets the flying speed of the enemy into the registers
BYTECODE_5F: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	
	REP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_FLYING_SPEED_OFFSET)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_1)
	
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Sets the flying speed from a register or value
BYTECODE_60: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)

	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	CMP_i (0x00FF)
	BNE_a (Using_Register)
	
Using_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	STA_d (PARSER_TEMP_VAR_1)
	BRA_a (Store_Value)
	
Using_Register:
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	STA_d (PARSER_TEMP_VAR_1)
	
Store_Value:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (AE_SCRIPT_FLYING_SPEED_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Sets the flying speed from an address location
BYTECODE_61: {
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)

	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_1)

Store_Value:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (AE_SCRIPT_FLYING_SPEED_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Sets the flying speed from an address location stored in var0 (LO) and var1 (HI)
BYTECODE_62: {
	BAT_MACRO_COPY_ADDR_VAR01_TO_TEMP(PARSER_TEMP_VAR_2, PARSER_TEMP_VAR_3)
	
	LDA_d (PARSER_TEMP_VAR_2)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_1)

Store_Value:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (AE_SCRIPT_FLYING_SPEED_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

