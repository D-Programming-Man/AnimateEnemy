	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)

	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	CMP_i (0x00FF)
	BNE_a (Using_Register)
	
Using_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	AND_i (0x0001)
	ASL
	ASL
	ASL
	STA_d (PARSER_TEMP_VAR_1)
	
	BRA_a (Store_Value)

Using_Register:
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	AND_i (0x0001)
	ASL
	ASL
	ASL
	STA_d (PARSER_TEMP_VAR_1)
	
Store_Value:
	LDA_i (AE_SCRIPT_SETTINGS_USE_HALF_PALETTE_CYCLE_BIT)
	EOR_i (0xFFFF)
	STA_d (PARSER_TEMP_VAR_2)
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_d (PARSER_TEMP_VAR_2)
	ORA_d (PARSER_TEMP_VAR_1)
	STA_x (AE_SCRIPT_SETTINGS_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

