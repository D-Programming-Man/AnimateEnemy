}

/*
	This needs to free up the space from the ANIMATE_ENEMY_LIST_ADDR at the end of battle.
	BowsprBattleSystem also has this modification as well, so if you deecide to use both
	scripts, just copy this ASM code to BowsprBattleSystem script file.
	
	Look for the "Clean_Up" label in the BowsprBattleSystem script, it should be all the way down at the end of the file
*/
ROM[0xC26185] = {
	JML (BAT_End_of_Battle_Free_AE)
}


/*
	Entry point for the script to do all fancy stuff for the enemy sprites
	Param: N/A
	Return: N/A
	
	DPR 0x06, 0x08, 0x0A, 0x0C are unused in this routine we're JSL-ing out of
*/
define OAM_NORMAL_ENEMY_SPRITEMAP_ADDR = 0xAAD6
define OAM_DARK_ENEMY_SPRITEMAP_ADDR = 0xAC16
define OAM_NORMAL_TO_DARK_SPRITEMAP_DISTANCE = 0x0140
define OAM_ENEMY_SPRITEMAP_MAX_SIZE = 0x50
define SpritemapToOAM = 0xC08CD5

define OAM_NORMAL_ENEMY_PALETTE_ADDR = 0x0300
define OAM_DARK_ENEMY_PALETTE_ADDR = 0x0380
define OAM_ENEMY_PALETTE_SIZE = 0x20
define OAM_NORMAL_TO_DARK_PALETTE_DISTANCE = 0x80
define OAM_ENEMY_PALETTE_ENTRY_SIZE = 0x02

define BAT_P_VAR0 = 0x06
define BAT_P_VAR1 = 0x08
define BAT_P_VAR2 = 0x0A
define BAT_P_VAR3 = 0x0C
define BAT_P_VAR4 = 0x18
define BAT_P_VAR5 = 0x1A
define BAT_P_VAR6 = 0x1C
define BAT_P_VAR7 = 0x1E

define OAM_SPRITEMAP_YPOS_OFFSET = 0x00
define OAM_SPRITEMAP_TILE_OFFSET = 0x01
define OAM_SPRITEMAP_ATTR_OFFSET = 0x02
	define OAM_SPRITEMAP_ATTR_VERT_BIT = 0x80
	define OAM_SPRITEMAP_ATTR_HORI_BIT = 0x40
	define OAM_SPRITEMAP_ATTR_PRIO_BIT_ALL = 0x30
		define OAM_SPRITEMAP_ATTR_PRIO_BIT_HI = 0x20
		define OAM_SPRITEMAP_ATTR_PRIO_BIT_LO = 0x10
	define OAM_SPRITEMAP_ATTR_PAL_ID_BIT_ALL = 0x0E
		define OAM_SPRITEMAP_ATTR_PAL_ID_BIT_HI = 0x80
		define OAM_SPRITEMAP_ATTR_PAL_ID_BIT_MED = 0x40
		define OAM_SPRITEMAP_ATTR_PAL_ID_BIT_LO = 0x20
	define OAM_SPRITEMAP_ATTR_HI_MAP_BIT = 0x01
define OAM_SPRITEMAP_XPOS_OFFSET = 0x03
define OAM_SPRITEMAP_SETT_OFFSET = 0x04

// MVN OPCode because asm65816.ccs doesn't have it
command MVN(srcbk, destbk) {"[54 {byte srcbk} {byte destbk}]"}

// Shortcut values to get the OAM byte size and amount of OAM... chunks(?) there are
OAMSpritemapSizeTable:	{"[00 05 0A 0A 14 28 50]"}	// DON'T TOUCH!!!


command OAMSpritemapFrameOffsetValue(frame, offset) "[{byte offset}]"
SIZE_32x32_FrameOffsetTable:{
	"[00 04 08 0C 40 44 48 4C 80 84 88 8C C0 C4 C8 CC]"
}

SIZE_64x32_FrameOffsetTable:{
	"[00 08 40 48 80 88 C0 C8]"
}

SIZE_32x64_FrameOffsetTable:{
	"[00 04 08 0C 80 84 88 8C]"
}

SIZE_64x64_FrameOffsetTable:{
	"[00 08 80 88]"
}

SIZE_128x64_FrameOffsetTable: {
	"[00 80]"
}

BAT_Parsesr: {
	PHY		// ypos of the sprite
	PHX		// xpos of the sprite
	PHA		// Address of the OAM Spritemap
	
	LDX_d (0x02)
	LDA_x (BATTLER_ID_OFFSET)
	CMP_i (0x0000)
	BEQ_a (OldCode)			// Instance where the ID of the enemy becomes 0, happens during when an enemy
							// does the battle enemy extender battle action when you set the action
							// argument to enemy ID 0 and the BTLACT_RAINBOW battle action, like when
							// you kill Carbon Dog and it transforms into Diamond Dog
	
	LDA_d (0x02)
	JSL (BAT_FindEntryAddr)
	CMP_i (0xFFFF)
	BEQ_a (OldCode)
	
	STA_d (BAT_P_VAR3)		// BAT_P_VAR3 = Address of the enemy's Animated Enemy List entry
	
	// Copies the OAM Spritemaps to ANIMATE_ENEMY_OAM_SCRATCH_ADDR
	LDA_i (short[0] ANIM_TABLE_ADDR)
	STA_d (BAT_P_VAR0)
	LDA_i (short[1] ANIM_TABLE_ADDR)
	STA_d (BAT_P_VAR1)
	
	LDX_d (0x02)
	LDA_x (BATTLER_ID_OFFSET)
	ASL
	ASL
	ASL
	CLC
	ADC_i (ANIM_TABLE_SPRITE_SIZE_OFFSET)
	TAY
	LDA_dly (BAT_P_VAR0)
	AND_i (0x00FF)
	STA_d (BAT_P_VAR2)		// BAT_P_VAR2 = Sprite Size
	
	INY
	LDA_dly (BAT_P_VAR0)
	AND_i (0x00FF)
	STA_d (BAT_P_VAR4)		// BAT_P_VAR4 = Canvas Size
	
	LDY_d (BAT_P_VAR2)
	
	LDA_i (short[0] OAMSpritemapSizeTable)
	STA_d (BAT_P_VAR0)
	LDA_i (short[1] OAMSpritemapSizeTable)
	STA_d (BAT_P_VAR1)
	
	LDA_dly (BAT_P_VAR0)
	AND_i (0x00FF)
	DEC
	
	PLX
	//PHX		// Copy the OAM Spritemap address
	LDY_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
	PHY			// Use our new address to load the OAM Spritemap
	
	MVN (0x7E, 0x7E)
	
	LDA_d (BAT_P_VAR3)
	JSL (Batscr_Parser)
	BEQ_a (OldCode)

	// Update's the frame of the enemy to the current frame
	LDA_d (BAT_P_VAR2)
	CMP_i (AnimateEnemy_Main.SIZE_32x32)
	BEQ_a (Is_SIZE_32x32)
	CMP_i (AnimateEnemy_Main.SIZE_64x32)
	BEQ_a (Is_SIZE_64x32)
	CMP_i (AnimateEnemy_Main.SIZE_32x64)
	BEQ_a (Is_SIZE_32x64)
	CMP_i (AnimateEnemy_Main.SIZE_64x64)
	BEQ_a (Is_SIZE_64x64)
	CMP_i (AnimateEnemy_Main.SIZE_128x64)
	BEQ_a (Is_SIZE_128x64)
	CMP_i (AnimateEnemy_Main.SIZE_128x128)
	BEQ_a (Is_SIZE_128x128)
	BRA_a (OldCode)	// No defined sprite size for this enemy
	
	Is_SIZE_32x32:
		LDA_d (BAT_P_VAR2)
		CMP_d (BAT_P_VAR4)
		BEQ_a (Update_Spritemap_Attr)	// If the same sprite and canvas size
		
		LDX_d (BAT_P_VAR3)
		LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
		AND_i (0x00FF)
		TAX	
		LDA_xl (SIZE_32x32_FrameOffsetTable)
		AND_i (0x00FF)
		
		JSL (BAT_Parsesr_Update_Frame)
		BRA_a (Update_Spritemap_Attr)
		
	
	Is_SIZE_64x32:
		LDA_d (BAT_P_VAR2)
		CMP_d (BAT_P_VAR4)
		BEQ_a (Update_Spritemap_Attr)	// If the same sprite and canvas size
		
		LDX_d (BAT_P_VAR3)
		LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
		AND_i (0x00FF)
		TAX	
		LDA_xl (SIZE_64x32_FrameOffsetTable)
		AND_i (0x00FF)
		
		JSL (BAT_Parsesr_Update_Frame)
		BRA_a (Update_Spritemap_Attr)
	
	Is_SIZE_32x64:
		LDA_d (BAT_P_VAR2)
		CMP_d (BAT_P_VAR4)
		BEQ_a (Update_Spritemap_Attr)	// If the same sprite and canvas size
	
		LDX_d (BAT_P_VAR3)
		LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
		AND_i (0x00FF)
		TAX	
		LDA_xl (SIZE_32x64_FrameOffsetTable)
		AND_i (0x00FF)
		
		JSL (BAT_Parsesr_Update_Frame)
		BRA_a (Update_Spritemap_Attr)
	
	Is_SIZE_64x64:
		LDA_d (BAT_P_VAR2)
		CMP_d (BAT_P_VAR4)
		BEQ_a (Update_Spritemap_Attr)	// If the same sprite and canvas size
	
		LDX_d (BAT_P_VAR3)
		LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
		AND_i (0x00FF)
		TAX	
		LDA_xl (SIZE_64x64_FrameOffsetTable)
		AND_i (0x00FF)
		
		JSL (BAT_Parsesr_Update_Frame)
		BRA_a (Update_Spritemap_Attr)
		
		
	Is_SIZE_128x64:
		LDA_d (BAT_P_VAR2)
		CMP_d (BAT_P_VAR4)
		BEQ_a (Update_Spritemap_Attr)	// If the same sprite and canvas size
	
		LDX_d (BAT_P_VAR3)
		LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
		AND_i (0x00FF)
		TAX	
		LDA_xl (SIZE_128x64_FrameOffsetTable)
		AND_i (0x00FF)
		
		JSL (BAT_Parsesr_Update_Frame)
		BRA_a (Update_Spritemap_Attr)
	
	Is_SIZE_128x128:
		BRA_a (Update_Spritemap_Attr) // Not doable... yet...
	
Update_Spritemap_Attr:
	JSL (BAT_Parser_Fix_Horizontal)
	JSL (BAT_Parser_Fix_Vertical)

	LDX_d (BAT_P_VAR3)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (0x00FE)
	STA_d (BAT_P_VAR5)	// BAT_P_VAR5 = Attribute byte
	
	LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
	SEP (0x20)
	
Update_Spritemap_Attr_Loop:
	LDA_x (OAM_SPRITEMAP_ATTR_OFFSET)
	AND_8 (0x09)		// Filter out the darken and high OAM bits
	ORA_d (BAT_P_VAR5)
	STA_x (OAM_SPRITEMAP_ATTR_OFFSET)
	
	LDA_x (OAM_SPRITEMAP_SETT_OFFSET)
	AND_8 (0x0080)
	BNE_a (OldCode)
	
	INX
	INX
	INX
	INX
	INX
	
	BRA_a (Update_Spritemap_Attr_Loop)
	
OldCode:
	REP (0x20)
	// Old Code
	PLA
	PLX
	PLY
	JSL (SpritemapToOAM)
	RTL
}

/*
	Updates the frame of the sprite
	Param: A = Offset value for each frame in OAM
	Return: N/A
*/

BAT_Parsesr_Update_Frame: {
	STA_d (BAT_P_VAR5)
	LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
	
OAM_Loop:
	LDA_x (OAM_SPRITEMAP_TILE_OFFSET)
	CLC
	ADC_d (BAT_P_VAR5)
	
	TAY
	AND_i (0x0030)	// Check if we are aligned correctly
	BEQ_a (OAM_Loop_Store_Frame) // If so, then no need to correct
	
	TYA
	CLC
	ADC_i (0x0040)	// Else, we snap the alignment 
	AND_i (0xFFCF)	// Get rid of any odd alignment
	TAY
		
OAM_Loop_Store_Frame:
	TYA
	STA_x (OAM_SPRITEMAP_TILE_OFFSET)
	
	LDA_x (OAM_SPRITEMAP_SETT_OFFSET)
	AND_i (0x0080)
	BNE_a (OAM_Loop_End)
	
	INX
	INX
	INX
	INX
	INX		// Go to the next OAM Spritemap entry
	
	BRA_a (OAM_Loop)
	
OAM_Loop_End:
	RTL
}

/*
	Fixes the enemy's horizontal sprite to be in the correct order
	Param: N/A
	Return: N/A
*/
BAT_Parser_Fix_Horizontal: {
	LDX_d (BAT_P_VAR3)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_HORIZONTAL_BIT)
	BEQ_a (Return)
	
	LDA_d (BAT_P_VAR2)
	CMP_i (AnimateEnemy_Main.SIZE_64x32)
	BEQ_a (Is_SIZE_64x32)
	CMP_i (AnimateEnemy_Main.SIZE_64x64)
	BEQ_a (Is_SIZE_64x64)
	CMP_i (AnimateEnemy_Main.SIZE_128x64)
	BEQ_a (Is_SIZE_128x64)
	CMP_i (AnimateEnemy_Main.SIZE_128x128)
	BEQ_a (Is_SIZE_128x128)
	BRA_a (Return)
	
	Is_SIZE_64x32:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		LDA_x (1)
		XBA
		LDA_x (6)
		XBA
		STA_x (6)
		XBA
		STA_x (1)
		
		BRA_a (Return)
		
	Is_SIZE_64x64:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		LDA_x (1)
		XBA
		LDA_x (6)
		XBA
		STA_x (6)
		XBA
		STA_x (1)
		
		LDA_x (11)
		XBA
		LDA_x (16)
		XBA
		STA_x (16)
		XBA
		STA_x (11)
		
		BRA_a (Return)
	
	Is_SIZE_128x64:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		LDA_x (1)
		XBA
		LDA_x (16)
		XBA
		STA_x (16)
		XBA
		STA_x (1)
		
		LDA_x (6)
		XBA
		LDA_x (11)
		XBA
		STA_x (11)
		XBA
		STA_x (6)
		
		LDA_x (21)
		XBA
		LDA_x (36)
		XBA
		STA_x (36)
		XBA
		STA_x (21)
		
		LDA_x (26)
		XBA
		LDA_x (31)
		XBA
		STA_x (31)
		XBA
		STA_x (26)
		
		BRA_a (Return)
	
	Is_SIZE_128x128:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		// 1st Row
		LDA_x (1)
		XBA
		LDA_x (16)
		XBA
		STA_x (16)
		XBA
		STA_x (1)
		
		LDA_x (6)
		XBA
		LDA_x (11)
		XBA
		STA_x (11)
		XBA
		STA_x (6)
		
		// 2nd Row
		LDA_x (21)
		XBA
		LDA_x (36)
		XBA
		STA_x (36)
		XBA
		STA_x (21)
		
		LDA_x (26)
		XBA
		LDA_x (31)
		XBA
		STA_x (31)
		XBA
		STA_x (26)
		
		// 3rd Row
		LDA_x (41)
		XBA
		LDA_x (56)
		XBA
		STA_x (56)
		XBA
		STA_x (41)
		
		LDA_x (46)
		XBA
		LDA_x (51)
		XBA
		STA_x (51)
		XBA
		STA_x (46)
		
		// 4th Row
		LDA_x (61)
		XBA
		LDA_x (76)
		XBA
		STA_x (76)
		XBA
		STA_x (61)
		
		LDA_x (66)
		XBA
		LDA_x (71)
		XBA
		STA_x (71)
		XBA
		STA_x (66)
	
Return:
	REP (0x20)
	RTL
}

/*
	Fixes the enemy's vertical sprite to be in the correct order
	Param: N/A
	Return: N/A
*/
BAT_Parser_Fix_Vertical: {
	LDX_d (BAT_P_VAR3)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_VERTICAL_BIT)
	BEQ_a (Return)
	
	LDA_d (BAT_P_VAR2)
	CMP_i (AnimateEnemy_Main.SIZE_32x64)
	BEQ_a (Is_SIZE_32x64)
	CMP_i (AnimateEnemy_Main.SIZE_64x64)
	BEQ_a (Is_SIZE_64x64)
	CMP_i (AnimateEnemy_Main.SIZE_128x64)
	BEQ_a (Is_SIZE_128x64)
	CMP_i (AnimateEnemy_Main.SIZE_128x128)
	BEQ_a (Is_SIZE_128x128)
	BRA_a (Return)
	
	Is_SIZE_32x64:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		LDA_x (1)
		CLC
		ADC_8 (0x40)
		STA_x (1)
		
		LDA_x (6)
		SEC
		SBC_8 (0x40)
		STA_x (6)
		
		BRA_a (Return)
		
	Is_SIZE_64x64:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		LDA_x (1)
		CLC
		ADC_8 (0x40)
		STA_x (1)
		
		LDA_x (6)
		SEC
		SBC_8 (0x40)
		STA_x (6)
		
		LDA_x (11)
		CLC
		ADC_8 (0x40)
		STA_x (11)
		
		LDA_x (16)
		SEC
		SBC_8 (0x40)
		STA_x (16)
		
		BRA_a (Return)
	
	Is_SIZE_128x64:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		LDA_x (1)
		CLC
		ADC_8 (0x40)
		STA_x (1)
		
		LDA_x (6)
		SEC
		SBC_8 (0x40)
		STA_x (6)
		
		LDA_x (11)
		CLC
		ADC_8 (0x40)
		STA_x (11)
		
		LDA_x (16)
		SEC
		SBC_8 (0x40)
		STA_x (16)
		
		LDA_x (21)
		CLC
		ADC_8 (0x40)
		STA_x (1)
		
		LDA_x (26)
		SEC
		SBC_8 (0x40)
		STA_x (6)
		
		LDA_x (31)
		CLC
		ADC_8 (0x40)
		STA_x (31)
		
		LDA_x (36)
		SEC
		SBC_8 (0x40)
		STA_x (36)
		
		BRA_a (Return)
	
	Is_SIZE_128x128:
		SEP (0x20)
		LDX_i (ANIMATE_ENEMY_OAM_SCRATCH_ADDR)
		
		// 1st Row
		LDA_x (1)
		CLC
		ADC_8 (0xC0)
		STA_x (1)
		
		LDA_x (6)
		CLC
		ADC_8 (0xC0)
		STA_x (6)
		
		LDA_x (11)
		CLC
		ADC_8 (0xC0)
		STA_x (11)
		
		LDA_x (16)
		CLC
		ADC_8 (0xC0)
		STA_x (16)
		
		// 2nd Row
		LDA_x (21)
		CLC
		ADC_8 (0x40)
		STA_x (21)
		
		LDA_x (26)
		CLC
		ADC_8 (0x40)
		STA_x (26)
		
		LDA_x (31)
		CLC
		ADC_8 (0x40)
		STA_x (31)
		
		LDA_x (36)
		CLC
		ADC_8 (0x40)
		STA_x (36)
		
		// 3rd Row
		LDA_x (41)
		SEC
		SBC_8 (0x40)
		STA_x (41)
		
		LDA_x (46)
		SEC
		SBC_8 (0x40)
		STA_x (46)
		
		LDA_x (51)
		SEC
		SBC_8 (0x40)
		STA_x (51)
		
		LDA_x (56)
		SEC
		SBC_8 (0x40)
		STA_x (56)
	
		// 4th Row
		LDA_x (61)
		SEC
		SBC_8 (0xC0)
		STA_x (61)
		
		LDA_x (66)
		SEC
		SBC_8 (0xC0)
		STA_x (66)
		
		LDA_x (71)
		SEC
		SBC_8 (0xC0)
		STA_x (71)
		
		LDA_x (76)
		SEC
		SBC_8 (0xC0)
		STA_x (76)
		
Return:
	REP (0x20)
	RTL
}

/*
	Initializes the enemy's animation data if they can animate
	Param: N/A
	Return: N/A
*/
define BATTLER_LIST_HEAD_ADDR = 0x9FAC
BAT_Animate_Enemy_Init: {
	PHA
	PHX
	PHY

	TXA
	CLC
	ADC_i (BATTLER_LIST_HEAD_ADDR)
	JSL (Batscr_Init)
	
OldCode:
	PLY
	PLX
	PLA

	LDA_d (0x14)
	INC
	STA_d (0x14)
	RTL
}

define BuildTargetName = 0xC23D05
Enemy_Backup_Init_Enemy_Animation: {
	JSL (BuildTargetName)
	LDA_a (0xA972)		// Load current battler target address (new enemy)
	JSL (Batscr_Init)
	RTL
}

Rainbow_of_Colors_Battle_Action_Fix: {
	REP (0x20)
	LDA_a (0xA970)
	JSL (BAT_FindEntryAddr)
	CMP_i (0xFFFF)
	BEQ_a (OldCode)
	
	TAX
	STZ_x (0x0000)		// Store 0 into the Animation Entry's enemy address pointer to clear it
						// Easy way to denote that this is a free entry to use to replace everything
						// In here
					
	LDA_a (0xA970)
	JSL (Batscr_Init)	// Re-initialize the Animated Enemy's data with the new enemy
	
	// Old Code
OldCode:
	REP (0x20)
	LDA_i (0x0001)
	
	RTL
}

/*
	Finds the enemy's index into the AnimateEnemy list
	Param: A = Enemy's Battler's Address
	Return: A = Index of the AnimateEnemy list
			    Returns 0xFFFF if not in the list
*/
define BATTLER_ENTRY_SIZE = 0x004E
define BATTLER_ENEMY_LIST_ADDR = 0xA21C
define MAX_ENEMIES = 0x0008

define BAT_FEI_TARGET_ADDR = 0x02
define BAT_FEI_ITER = 0x04
define BAT_FEI_CURR_ADDR = 0x06
BAT_FindEntryIndex: {
	REP (0x31)
	PHD
	PHA
	TDC
	ADC_i (0xFFEE)
	TCD
	PLA
	
	STA_d (BAT_FEI_TARGET_ADDR)
	STZ_d (BAT_FEI_ITER)
	LDA_i (BATTLER_ENEMY_LIST_ADDR)
	STA_d (BAT_FEI_CURR_ADDR)
Loop:
	LDA_d (BAT_FEI_CURR_ADDR)
	CMP_d (BAT_FEI_TARGET_ADDR)
	BEQ_a (Return)
	
	LDA_d (BAT_FEI_ITER)
	INC
	CMP_i (MAX_ENEMIES)
	BEQ_a (NotInList)
	
	LDA_d (BAT_FEI_CURR_ADDR)
	CLC
	ADC_i (BATTLER_ENTRY_SIZE)
	STA_d (BAT_FEI_CURR_ADDR)
	BRA_a (Loop)

NotInList:
	LDA_i (0xFFFF)
	STA_d (BAT_FEI_ITER)

Return:	
	LDA_d (BAT_FEI_ITER)
	
	PLD
	RTL
}

/*
	Finds the enemy's index into the AnimateEnemy list
	Param: A = Enemy's Battler's Address
	Return: A = The addres of that entry from the list
				Returns 0xFFFF if the enemy doens't exists
*/
define Mul16x8r16 = 0xC08FF7

define BAT_FEA_BATTLER_ENEMY_ADDR = 0x02
BAT_FindEntryAddr: {
	REP (0x31)
	PHD
	PHA
	TDC
	ADC_i (0xFFFE)
	TCD
	PLA
	
	STA_d (BAT_FEA_BATTLER_ENEMY_ADDR)
	LDX_i (ANIMATE_ENEMY_LIST_ADDR)
	LDY_i (MAX_ENEMIES)
Loop:
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	CMP_d (BAT_FEA_BATTLER_ENEMY_ADDR)
	BEQ_a (Return)
	
	TXA
	CLC
	ADC_i (ANIMATE_ENEMY_ENTRY_SIZE)
	TAX
	
	DEY
	CPY_i (0x0000)
	BNE_a (Loop)
	
	LDX_i (0xFFFF)
	
Return:
	TXA
	PLD
	RTL
}

/*
	Finds a free entry within the list
	Param: N/A
	Return: A = Address of that entry
				Returns 0xFFFF if there is none
*/
define BATTLER_PERM_STAT_OFFSET = 0x1D
BAT_FindFreeEntry: {
	REP (0x31)
	PHD
	TDC
	ADC_i (0xFFEE)
	TCD
	
	LDY_i (MAX_ENEMIES)
	LDX_i (ANIMATE_ENEMY_LIST_ADDR)
	STX_d (0x02)
	
Loop:
	LDX_d (0x02)
	
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	BEQ_a (Return)
	
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_i (0x0080)	// IF killswitch is on, then overwrite this entry
	BNE_a (Return)
	
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_PERM_STAT_OFFSET)
	AND_i (0x00FF)
	CMP_i (0x0001)
	BEQ_a (Return)	// If a previous animated enemy is dead, then overwrite this entry
	
	LDA_d (0x02)
	CLC
	ADC_i (ANIMATE_ENEMY_ENTRY_SIZE)
	STA_d (0x02)
	
	DEY
	CPY_i (0x0000)
	BNE_a (Loop)
	
	LDA_i (0xFFFF)
	STA_d (0x02)
	
Return:
	LDA_d (0x02)
	PLD
	RTL
}

BAT_End_of_Battle_Free_AE: {
	LDX_i (ANIMATE_ENEMY_LIST_ADDR)
	LDA_i (0)
	
Loop:
	STA_x (0x0000)
	INX
	INX
	CPX_i (0x0800)
	BNE_a (Loop)
	
	// Old Code, do not copy this to BowsprBattleSystem. Copy everything above
	LDA_d (0x17)
	PLD
	RTL
}

/*
	This initializes each enemy into the Animate Enemy List
	Param: A = Enemy's Battler's address
	Return: N/A
*/
define AE_SCRIPT_BATTLER_ADDR = 0x00
define AE_PALETTE_POINTER_LO_OFFSET = 0x02
define AE_PALETTE_POINTER_HI_OFFSET = 0x04
define AE_SCRIPT_PC_LO_OFFSET = 0x05
define AE_SCRIPT_PC_HI_OFFSET = 0x07
define AE_SCRIPT_RESULT_OFFSET = 0x08
define AE_SCRIPT_VAR0_OFFSET = 0x0A
define AE_SCRIPT_VAR1_OFFSET = 0x0C
define AE_SCRIPT_VAR2_OFFSET = 0x0E
define AE_SCRIPT_BASE_XPOS_OFFSET = 0x10
define AE_SCRIPT_BASE_YPOS_OFFSET = 0x11
define AE_SCRIPT_CURRENT_FRAME_OFFSET = 0x12
define AE_SCRIPT_PAUSE_FRAME_OFFSET = 0x13
define AE_SCRIPT_PALETTE_CYCLE_RATE_OFFSET = 0x14
define AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET = 0x15
define AE_SCRIPT_FLYING_HEIGHT_OFFSET = 0x16
define AE_SCRIPT_FLYING_SPEED_OFFSET = 0x17
define AE_SCRIPT_FLYING_COUNTER_OFFSET = 0x18
define AE_SCRIPT_ATTRIBUTES_OFFSET = 0x19
define	AE_SCRIPT_ATTRIBUTES_VERTICAL_BIT = 0x80
define	AE_SCRIPT_ATTRIBUTES_HORIZONTAL_BIT = 0x40
define	AE_SCRIPT_ATTRIBUTES_PRIORITY_DRAW_BIT_ALL = 0x30
define		AE_SCRIPT_ATTRIBUTES_PRIORITY_DRAW_BIT_HI = 0x20
define		AE_SCRIPT_ATTRIBUTES_PRIORITY_DRAW_BIT_LO = 0x10
define	AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL = 0x0E
define		AE_SCRIPT_ATTRIBUTES_PALETTE_ID_BIT_HI = 0x08
define		AE_SCRIPT_ATTRIBUTES_PALETTE_ID_BIT_MED = 0x04
define		AE_SCRIPT_ATTRIBUTES_PALETTE_ID_BIT_LO = 0x02
define	AE_SCRIPT_ATTRIBUTES_USE_OAM_HI_BIT = 0x01
	
define AE_SCRIPT_SETTINGS_OFFSET = 0x1A
	define AE_SCRIPT_SETTINGS_KILLSWITCH_BIT = 0x80
	define AE_SCRIPT_SETTINGS_SOFT_TOGGLE_BIT = 0x40
	define AE_SCRIPT_SETTINGS_FLYING_BIT	= 0x20
	define AE_SCRIPT_SETTINGS_CYCLE_PALETTE_BIT = 0x10
	define AE_SCRIPT_SETTINGS_USE_HALF_PALETTE_CYCLE_BIT = 0x08

define ANIM_TABLE_ADDR = AnimateEnemy_Main.AnimationTable
define ANIM_TABLE_MAX_FRAME_OFFSET = 0x00
define ANIM_TABLE_SPRITE_SIZE_OFFSET = 0x01
define ANIM_TABLE_CANVAS_SIZE_OFFSET = 0x02
define ANIM_TABLE_SCRIPT_OFFSET = 0x04

define BATTLER_ID_OFFSET = 0x00
define BATTLER_EXISTANCE_OFFSET = 0x0C
define BATTLER_IS_ENEMY_OFFSET = 0x0E
define BATTLER_OAM_SPRITE_ID_OFFSET = 0x43
define BATTLER_XPOS_OFFSET = 0x44
define BATTLER_YPOS_OFFSET = 0x45

define INIT_ENEMY_BATTLER_ADDR = 0x02
define INIT_ANIM_ENEMY_ENTRY_ADDR = 0x04
define INIT_ANIM_TABLE_LO_ADDR = 0x06
define INIT_ANIM_TABLE_HI_ADDR = 0x08
Batscr_Init: {
	REP (0x31)
	PHD
	PHA
	TDC
	ADC_i (0xFFEE)
	TCD
	PLA	

	STA_d (INIT_ENEMY_BATTLER_ADDR)
	TAX

	// Does the batter exists? If not then skip them
	LDA_x (BATTLER_EXISTANCE_OFFSET)
	AND_i (0x00FF)
	BEQ_a (Return)
	
	// Are they an enemy? If not then skip them
	LDA_x (BATTLER_IS_ENEMY_OFFSET)
	AND_i (0x00FF)
	BEQ_a (Return)
	
	// Find a free entry in the Animate Enemy List
	LDA_d (INIT_ENEMY_BATTLER_ADDR)
	JSL (BAT_FindFreeEntry)
	CMP_i (0xFFFF)
	BEQ_a (Return)
	
	STA_d (INIT_ANIM_ENEMY_ENTRY_ADDR)
	TAX
	
	// Init Script address to enemy. If script doesn't exists, then don't load them in. 
	LDA_i (short[0] ANIM_TABLE_ADDR)
	STA_d (INIT_ANIM_TABLE_LO_ADDR)
	LDA_i (short[1] ANIM_TABLE_ADDR)
	STA_d (INIT_ANIM_TABLE_HI_ADDR)
	
	LDX_d (INIT_ENEMY_BATTLER_ADDR)
	LDA_x (BATTLER_ID_OFFSET)
	ASL
	ASL
	ASL
	CLC
	ADC_i (ANIM_TABLE_SCRIPT_OFFSET)
	INC
	INC		// Get HI address first, guarentees us script is there or not
	TAY
	LDA_dly (INIT_ANIM_TABLE_LO_ADDR)
	BEQ_a (Return)	// No Script label associated with this enemy if 0
	
	LDX_d (INIT_ANIM_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_PC_HI_OFFSET)
	DEY
	DEY		// Get LO address next
	LDA_dly (INIT_ANIM_TABLE_LO_ADDR)
	STA_x (AE_SCRIPT_PC_LO_OFFSET)
	
	// Init the battler's address to the entry
	LDA_d (INIT_ENEMY_BATTLER_ADDR)
	LDX_d (INIT_ANIM_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_BATTLER_ADDR)
	
	// Copy base X and Y pos of enemies to the entry
	LDX_d (INIT_ENEMY_BATTLER_ADDR)
	LDA_x (BATTLER_XPOS_OFFSET)	// Since A is 16-bit, we load in x and y pos
	LDX_d (INIT_ANIM_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_BASE_XPOS_OFFSET)
	
	LDX_d (INIT_ENEMY_BATTLER_ADDR)
	LDA_x (BATTLER_OAM_SPRITE_ID_OFFSET)
	AND_i(0x00FF)
	TAY
	LDA_i (OAM_ENEMY_SPRITEMAP_MAX_SIZE)
	JSL (Mul16x8r16)
	CLC
	ADC_i (OAM_NORMAL_ENEMY_SPRITEMAP_ADDR)
	TAX
	LDA_x (OAM_SPRITEMAP_ATTR_OFFSET)
	AND_i (0x00FF)
	
	SEP (0x20)
	LDX_d (INIT_ANIM_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	REP (0x20)
	
	// Zero out all other settings
	LDA_i (0x0000)
	STA_x (AE_PALETTE_POINTER_LO_OFFSET)
	STA_x (AE_SCRIPT_RESULT_OFFSET)
	STA_x (AE_SCRIPT_VAR0_OFFSET)
	STA_x (AE_SCRIPT_VAR1_OFFSET)
	STA_x (AE_SCRIPT_VAR2_OFFSET)
	SEP (0x20)
	STA_x (AE_PALETTE_POINTER_HI_OFFSET)
	STA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	STA_x (AE_SCRIPT_PAUSE_FRAME_OFFSET)
	STA_x (AE_SCRIPT_PALETTE_CYCLE_RATE_OFFSET)
	STA_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	STA_x (AE_SCRIPT_FLYING_HEIGHT_OFFSET)
	STA_x (AE_SCRIPT_FLYING_SPEED_OFFSET)
	STA_x (AE_SCRIPT_FLYING_COUNTER_OFFSET)
	STA_x (AE_SCRIPT_SETTINGS_OFFSET)
	REP (0x20)

Return:
	PLD
	RTL
}

/*
	RAM Ranges:
	https://gist.github.com/Supremekirb/33089ef23ef1e3677d80f38479e4cb2e
	
	The Animate Enemy List will take up the unused space in RAM at 0x0720
	Using RAM Range: 0x0720 - 0x07E8 (200 bytes)
	Free RAM Range: 0x07E9 - 0x07FF (24 bytes)
	
	The OAM scratch will also take up this amount of space:
	Using RAM Range: 0x3248 - 0x3298 (80 bytes) // RAM address right after movscr_codes.ccs
	Free RAM RAnge: 0x3299 - 0x3329 (145 Bytes)
	
	Does all of the parsing of the commands for this enemy
	Param:	A = Enemy's address entry to the Animate Enemy List
	Return: A = Was the enemy able to run its script or pause?
			    0 = False, 1 = True
		   
*/
define ANIMATE_ENEMY_LIST_ADDR = 0x0720
define ANIMATE_ENEMY_OAM_SCRATCH_ADDR = 0x3248
define ANIMATE_ENEMY_ENTRY_SIZE = 0x1B

define JSL_LongJump_00BC = 0xC09279
define RAM_JUMP_LO_ADDR = 0x00BC
define RAM_JUMP_HI_ADDR = 0x00BE

define PARSER_ANIMATE_ENEMY_ENTRY_ADDR = 0x02
define PARSER_BYTE_CODE_TABLE_LO_ADDR = 0x04
define PARSER_BYTE_CODE_TABLE_HI_ADDR = 0x06
define PARSER_SCRIPT_PC_LO_ADDR = 0x08
define PARSER_SCRIPT_PC_HI_ADDR = 0x0A
define PARSER_BYTE_CODE_PARAM_1 = 0x0C
define PARSER_BYTE_CODE_PARAM_2 = 0x0E
define PARSER_BYTE_CODE_PARAM_3 = 0x10
define PARSER_BYTE_CODE_PARAM_4 = 0x12
define PARSER_BYTE_CODE_PARAM_5 = 0x14
define PARSER_BYTE_CODE_PARAM_6 = 0x16
define PARSER_BYTE_CODE_PARAM_7 = 0x18
define PARSER_TEMP_VAR_1 = 0x1A
define PARSER_TEMP_VAR_2 = 0x1C
define PARSER_TEMP_VAR_3 = 0x1E
define PARSER_TEMP_VAR_4 = 0x20

Batscr_Parser: {
	REP (0x31)
	PHD
	PHA
	TDC
	ADC_i (0xFFDE)
	TCD
	PLA
	TAX
	
	STX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	
Check_Flying:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_8 (AE_SCRIPT_SETTINGS_FLYING_BIT)
	BEQ_a (Check_Palette_Cycle)
	
	
	// Enemy is flying
	REP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_FLYING_SPEED_OFFSET)
	AND_i (0x00FF)
	TAY
	LDA_a (0x0002)	// 8bit frame counter
	AND_i (0x00FF)
	JSL (0xC09231)	// Mod16_Unsigned
	CMP_i (0x0000)
	BNE_a (Check_Palette_Cycle)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_FLYING_COUNTER_OFFSET)
	AND_i (0x007F)
	
	TAX
	LDA_xl (0xC0B425)
	AND_i (0x00FF)
	TAY
	STA_d (PARSER_TEMP_VAR_1)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_FLYING_HEIGHT_OFFSET)
	AND_i (0x00FF)
	TAY
	LDA_d (PARSER_TEMP_VAR_1)
	JSL (0xC0914B) 	// Divide_YxA
	STA_d (PARSER_TEMP_VAR_1)
	
	LDA_x (AE_SCRIPT_FLYING_COUNTER_OFFSET)
	AND_i (0x0080)
	BNE_a (Check_Flying_Going_Down)
	
	LDA_d (PARSER_TEMP_VAR_1)
	EOR_i (0xFFFF)
	INC
	STA_d (PARSER_TEMP_VAR_1)
	
Check_Flying_Going_Down:
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BASE_YPOS_OFFSET)
	AND_i (0x00FF)
	CLC
	ADC_d (PARSER_TEMP_VAR_1)
	AND_i (0x00FF)
	TAY
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	TYA
	
	SEP (0x20)
	STA_x (BATTLER_YPOS_OFFSET)
	
Check_Flying_Increment:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_FLYING_COUNTER_OFFSET)
	INC
	STA_x (AE_SCRIPT_FLYING_COUNTER_OFFSET)
	
Check_Palette_Cycle:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_8 (AE_SCRIPT_SETTINGS_CYCLE_PALETTE_BIT)
	BEQ_a (Check_Killswitch)
	
	LDA_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	INC
	STA_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	
	LDA_x (AE_SCRIPT_PALETTE_CYCLE_RATE_OFFSET)
	SEC
	SBC_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	BNE_a (Check_Killswitch)
	
Check_Palette_Cycle_Loop_Init:
	REP (0x20)

	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_i (AE_SCRIPT_SETTINGS_USE_HALF_PALETTE_CYCLE_BIT)
	BEQ_a (Check_Palette_Cycle_Loop_Use_Full_Palette)
	
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	LSR
	STA_d (PARSER_TEMP_VAR_4)
	BRA_a (Check_Palette_Cycle_Loop_Init_2)
	
Check_Palette_Cycle_Loop_Use_Full_Palette:
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	STA_d (PARSER_TEMP_VAR_4)
	
Check_Palette_Cycle_Loop_Init_2:
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL)
	LSR
	TAY
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	JSL (Mul16x8r16)
	CLC
	ADC_i (OAM_NORMAL_ENEMY_PALETTE_ADDR)
	INC
	INC		// Start on the 1st palette color, the 0th is the transparency
	STA_d (PARSER_TEMP_VAR_1)
	TAX
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	LDY_i (0x0004)

Check_Palette_Cycle_Loop:
	CPY_d (PARSER_TEMP_VAR_4)
	BEQ_a (Check_Palette_Cycle_Loop_End)
	
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0002)
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	
	INX
	INX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
	INY
	INY
	
	BRA_a (Check_Palette_Cycle_Loop)
	
Check_Palette_Cycle_Loop_End:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_i (OAM_NORMAL_TO_DARK_PALETTE_DISTANCE)
	TAX
	LDY_i (0x0004)
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
Check_Dark_Palette_Cycle_Loop:
	CPY_d (PARSER_TEMP_VAR_4)
	BEQ_a (Check_Dark_Palette_Cycle_Loop_End)
	
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0002)
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	
	INX
	INX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
	INY
	INY
	
	BRA_a (Check_Dark_Palette_Cycle_Loop)
	
Check_Dark_Palette_Cycle_Loop_End:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	LDA_8 (0x00)
	STA_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	
Check_Palette_Cycle_Zero_Others:
	REP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STX_d (PARSER_TEMP_VAR_1)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_ID_OFFSET)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_i (ANIMATE_ENEMY_LIST_ADDR)
	STA_d (PARSER_TEMP_VAR_3)
	LDY_i (0x0000)

Check_Palette_Cycle_Zero_Others_Loop:
	CPY_i (0x0008)
	BEQ_a (Check_Killswitch)
	
	LDA_d (PARSER_TEMP_VAR_3)
	CMP_d (PARSER_TEMP_VAR_1)
	BEQ_a (Check_Palette_Cycle_Check_Next_Enemy)	// Checks if the same enemy
	
	TAX
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_ID_OFFSET)
	CMP_d (PARSER_TEMP_VAR_2)
	BNE_a (Check_Palette_Cycle_Check_Next_Enemy)	// Checks if the same type enemy
	
	LDX_d (PARSER_TEMP_VAR_1)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL)
	STA_d (PARSER_TEMP_VAR_4)
	
	LDX_d (PARSER_TEMP_VAR_3)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL)
	CMP_d (PARSER_TEMP_VAR_4)
	BNE_a (Check_Palette_Cycle_Check_Next_Enemy)	// Checks if using the same palette ID
	
	SEP (0x20)
	LDX_d (PARSER_TEMP_VAR_3)
	LDA_8 (0x00)
	STA_x (AE_SCRIPT_PALETTE_CYCLE_COOLDOWN_OFFSET)
	REP (0x20)
	
Check_Palette_Cycle_Check_Next_Enemy:
	INY
	
	LDA_d (PARSER_TEMP_VAR_3)
	CLC
	ADC_i (ANIMATE_ENEMY_ENTRY_SIZE)
	STA_d (PARSER_TEMP_VAR_3)
	
	BRA_a (Check_Palette_Cycle_Zero_Others_Loop)
	
Check_Killswitch:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_8 (AE_SCRIPT_SETTINGS_KILLSWITCH_BIT)	// Focus only on the Setting's kill switch 
	BEQ_a (Check_SoftToggle)	// If they're not on, then go to the next 
	
	LDY_i (0x0000)
	BRA_a (Return)	// Do nothing to the enemy and return
	
Check_SoftToggle:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_8 (AE_SCRIPT_SETTINGS_SOFT_TOGGLE_BIT)
	BEQ_a (Check_If_Pause)
	
	LDY_i (0x0001)
	BRA_a (Return)	// Do nothing to the enemy and return
	
Check_If_Pause:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_PAUSE_FRAME_OFFSET)
	BEQ_a (Main)
	
	DEC
	STA_x (AE_SCRIPT_PAUSE_FRAME_OFFSET)
	LDY_i (0x0001)
	BRA_a (Return)
	
Main:
	REP (0x20)
	
	// Fetch the byte code of the script
	LDA_x (AE_SCRIPT_PC_LO_OFFSET)
	STA_d (PARSER_SCRIPT_PC_LO_ADDR)
	LDA_x (AE_SCRIPT_PC_HI_OFFSET)
	AND_i (0x00FF)
	STA_d (PARSER_SCRIPT_PC_HI_ADDR)
	CMP_i (0x0000)
	BEQ_a (Return)
	
	LDA_i (short[0] ByteCodeJumpTable)
	STA_d (PARSER_BYTE_CODE_TABLE_LO_ADDR)
	LDA_i (short[1] ByteCodeJumpTable)
	STA_d (PARSER_BYTE_CODE_TABLE_HI_ADDR)
	
	LDA_dl (PARSER_SCRIPT_PC_LO_ADDR)
	AND_i (0x00FF)
	ASL
	ASL
	TAY
	LDA_dly (PARSER_BYTE_CODE_TABLE_LO_ADDR)
	STA_a (RAM_JUMP_LO_ADDR)
	INY
	INY
	LDA_dly (PARSER_BYTE_CODE_TABLE_LO_ADDR)
	AND_i (0x00FF)
	STA_a (RAM_JUMP_HI_ADDR)
	
	INC_d (PARSER_SCRIPT_PC_LO_ADDR)	// INC PC, reading parameter bytes
	
	JSL (JSL_LongJump_00BC)
	
	BRA_a (Check_Killswitch)
		
Return:
	REP (0x20)
	TYA
	
	PLD
	RTL
}

ByteCodeJumpTable: {
	long BYTECODE_00
	long BYTECODE_01
	long BYTECODE_02
	long BYTECODE_03
	long BYTECODE_04
	long BYTECODE_05
	long BYTECODE_06
	long BYTECODE_07
	long BYTECODE_08
	long BYTECODE_09
	long BYTECODE_0A
	long BYTECODE_0B
	long BYTECODE_0C
	long BYTECODE_0D
	long BYTECODE_0E
	long BYTECODE_0F
	long BYTECODE_10
	long BYTECODE_11
	long BYTECODE_12
	long BYTECODE_13
	long BYTECODE_14
	long BYTECODE_15
	long BYTECODE_16
	long BYTECODE_17
	long BYTECODE_18
	long BYTECODE_19
	long BYTECODE_1A
	long BYTECODE_1B
	long BYTECODE_1C
	long BYTECODE_1D
	long BYTECODE_1E
	long BYTECODE_1F
	long BYTECODE_20
