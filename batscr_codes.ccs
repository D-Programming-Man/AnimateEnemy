	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_i (PARSER_BYTE_CODE_PARAM_1)
	STA_x (AE_PALETTE_POINTER_LO_OFFSET)
	LDA_i (PARSER_BYTE_CODE_PARAM_2)
	SEP (0x20)
	STA_x (AE_PALETTE_POINTER_HI_OFFSET)
	
	REP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	TAX
	LDA_x (BATTLER_OAM_SPRITE_ID_OFFSET)
	AND_i (0x00FF)
	TAY
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	JSL (Mul16x8r16)
	CLC
	ADC_i (OAM_NORMAL_ENEMY_PALETTE_ADDR)
	STA_d (PARSER_TEMP_VAR_1)
	TAX
	
	LDY_i (0x0000)
	
Normal_Palette_Loop:
	CPY_i (OAM_ENEMY_PALETTE_SIZE)
	BEQ_a (Normal_Palette_Loop_End)
	
	LDA_dly (PARSER_BYTE_CODE_PARAM_1)
	STA_x (0x0000)
	
	INX
	INX
	
	INY
	INY
	
	BRA_a (Normal_Palette_Loop)
	
Normal_Palette_Loop_End:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_i (OAM_NORMAL_TO_DARK_PALETTE_DISTANCE)
	TAX
	
	LDY_i (0x0000)
	
Dark_Palette_Loop:
	CPY_i (OAM_ENEMY_PALETTE_SIZE)
	BEQ_a (Return)
	
	LDA_dly (PARSER_BYTE_CODE_PARAM_1)
	
	LSR
	LSR
	AND_i (0x1CE7)	// Darken palette color 
	
	STA_x (0x0000)
	
	INX
	INX
	
	INY
	INY
	
	BRA_a (Dark_Palette_Loop)

Return:
	JMP_l (Parser_Common_Return)
}


