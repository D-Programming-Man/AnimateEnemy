}

BYTECODE_6A: {
	BAT_MACRO_COPY_ADDR_VAR01_TO_TEMP(PARSER_TEMP_VAR_2, PARSER_TEMP_VAR_3)

	LDA_dl (PARSER_TEMP_VAR_2)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_1)
	BRA_a (Store_Value)

Store_Value:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_d (PARSER_TEMP_VAR_1)
