	ORA_d (PARSER_TEMP_VAR_1) 
	STA_d (PARSER_TEMP_VAR_1)

Store_Value:
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL)
