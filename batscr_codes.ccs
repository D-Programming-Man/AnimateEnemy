	long BYTECODE_80
}

//+=+=+=+=+= BYTECODE MACROS =+=+=+=+=+
command BAT_MACRO_LOAD_8BIT_PARAM(param_var) {
	LDA_dl (PARSER_SCRIPT_PC_LO_ADDR)
	INC_d (PARSER_SCRIPT_PC_LO_ADDR)
	AND_i (0x00FF)
	STA_d (param_var)
}
command BAT_MACRO_LOAD_16BIT_PARAM(param_var) {
	LDA_dl (PARSER_SCRIPT_PC_LO_ADDR)
	INC_d (PARSER_SCRIPT_PC_LO_ADDR)
	INC_d (PARSER_SCRIPT_PC_LO_ADDR)
	STA_d (param_var)
}
command BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(param_var, ae_offset) {
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_d (param_var)
	ASL
	CLC
	ADC_i (ae_offset)
	CLC
	ADC_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
}
command BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(param_var, ae_offset) {
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(param_var, ae_offset)
	TAX
	LDA_x (0x0000)
	AND_i (0x00FF)
}
command BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(param_var, ae_offset) {
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(param_var, ae_offset)
	TAX
	LDA_x (0x0000)
}
command BAT_MACRO_COPY_ADDR_VAR01_TO_TEMP(lo_addr, hi_addr) {
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_VAR0_OFFSET)
	STA_d (lo_addr)
	LDA_x (AE_SCRIPT_VAR0_OFFSET)
	STA_d (hi_addr)
}
//+=+=+=+=+= BYTECODE ASM =+=+=+=+=+
// Halt's code execution (infinite loop)
BYTECODE_00: {
	BRA_a (BYTECODE_00)
	JMP_l (Parser_Common_Return)
}

// Pause enemy's script for a set or variable amounts of time
BYTECODE_01: {	
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	REP (0x20)
	LDY_d (PARSER_BYTE_CODE_PARAM_1)
	CPY_i (0x00FF)
	BEQ_a (Pause_from_Value)
	
	REP (0x20)
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	BRA_a (Store_Frame_Count)
	
Pause_from_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	
Store_Frame_Count:
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_PAUSE_FRAME_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Pause enemy's script by some amount from an address
BYTECODE_02: {	
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	LDA_dl (PARSER_BYTE_CODE_PARAM_1)	// Contains address for our value to pause
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_PAUSE_FRAME_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Pause enemy's script by some amount from an address at var0 (LO) and var1 (HI)
BYTECODE_03: {	
	BAT_MACRO_COPY_ADDR_VAR01_TO_TEMP(PARSER_TEMP_VAR_1, PARSER_TEMP_VAR_2)
	LDA_dl (PARSER_TEMP_VAR_1)	// Contains address for our value to pause
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_PAUSE_FRAME_OFFSET)
	
Return:
	JMP_l (Parser_Common_Return)	
}

// Set result or var0 to var2 a value given in its parameters
BYTECODE_04: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Set result or var0 to var2 a value from a memory address
BYTECODE_05: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_3)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_4)
	
	LDA_dl (PARSER_BYTE_CODE_PARAM_3)
	STA_d (PARSER_TEMP_VAR_1)
	
	LDY_d (PARSER_BYTE_CODE_PARAM_1)
	CPY_i (0x0001)
	BEQ_a (Store_16Bit_Value)
	
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_1)
	
Store_16Bit_Value:
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Set result or var0 to var2 a value from a memory address stored
// in var0 (LO) and var1 (HI)
BYTECODE_06: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	REP (0x20)
	BAT_MACRO_COPY_ADDR_VAR01_TO_TEMP(PARSER_TEMP_VAR_1, PARSER_TEMP_VAR_2)
	
	LDA_dl (PARSER_TEMP_VAR_1)
	STA_d (PARSER_TEMP_VAR_3)
	
	LDY_d (PARSER_BYTE_CODE_PARAM_1)
	CPY_i (0x0001)
	BEQ_a (Store_16Bit_Value)
	
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_3)
	
Store_16Bit_Value:
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Copies data from one register to another
BYTECODE_07: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	STA_d (PARSER_TEMP_VAR_1)
	
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Swaps data from one register to another
BYTECODE_08: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	REP (0x20)
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	STA_d (PARSER_TEMP_VAR_1)
	
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	STA_d (PARSER_TEMP_VAR_2)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_d (PARSER_TEMP_VAR_1)
	STA_x (0x0000)
	TYX
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Sets a value to an address from the registers or a constant value
BYTECODE_09: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)	// 8/16 bit addressing mode
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)	// what register we using, if any
	
	REP (0x20)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_3)// Address (LO)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_4)// Address (HI)
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_5)// The value, if not using registers
	
	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	CMP_i (0x0001)
	BEQ_a (Using_16Bit)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	CMP_i (0x00FF)
	BNE_a (Using_8Bit_Register)
	
Using_8Bit_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_5)
	BRA_a (Store_8Bit_Value)
	
Using_8Bit_Register:
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	BRA_a (Store_8Bit_Value)
	
Using_16Bit:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	CMP_i (0x00FF)
	BNE_a (Using_16Bit_Register)
	
Using_16Bit_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_5)
	BRA_a (Store_16Bit_Value)
	
Using_16Bit_Register:
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	BRA_a (Store_16Bit_Value)
	
Store_8Bit_Value:
	SEP (0x20)
Store_16Bit_Value:
	STA_dl (PARSER_BYTE_CODE_PARAM_3)
	
Return:
	JMP_l (Parser_Common_Return)
}

// Sets a value to an address stored in var0 (LO) and var1 (HI) from the registers or a constant value
BYTECODE_0A: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)	// 8/16 bit addressing mode
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)	// what register we using, if any

	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_3)// The value, if not using registers
	BAT_MACRO_COPY_ADDR_VAR01_TO_TEMP(PARSER_TEMP_VAR_1, PARSER_TEMP_VAR_2)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_1)
	CMP_i (0x0001)
	BEQ_a (Using_16Bit)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	CMP_i (0x00FF)
	BNE_a (Using_8Bit_Register)
	
Using_8Bit_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	BRA_a (Store_8Bit_Value)

Using_8Bit_Register:
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	BRA_a (Store_8Bit_Value)
	
Using_16Bit:
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	CMP_i (0x00FF)
	BNE_a (Using_16Bit_Register)

Using_16Bit_Value:
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	BRA_a (Store_16Bit_Value)
	
Using_16Bit_Register:
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_2, AE_SCRIPT_RESULT_OFFSET)
	BRA_a (Store_16Bit_Value)
	
Store_8Bit_Value:
	SEP (0x20)
Store_16Bit_Value:
	STA_dl (PARSER_TEMP_VAR_1)

Return:
	JMP_l (Parser_Common_Return)
}

// Adds a constant value to the result and var0 to var2 registers
BYTECODE_0B: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)

	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	CLC
	ADC_d (PARSER_BYTE_CODE_PARAM_2)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)

}

