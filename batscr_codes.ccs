//+=+=+=+=+= ASM =+=+=+=+=+
ROM[0xC2F729] = ADC_i (0xFFE0)	// Need some extra storage space for this routine here
ROM[0xC2F801] = {
	JSL (BAT_Parsesr)
}

ROM[0xC2F846] = {
	JSL (BAT_Parsesr)
}

ROM[0xC2F89B] = {
	JSL (BAT_Parsesr)
}


ROM[0xC2F8D5] = {
	JSL (BAT_Parsesr)
}

// Located in 0xC2F121
ROM[0xC2F544] = {
	JSL (BAT_Animate_Enemy_Init)
	NOP
}

// "Call For Help" and "Sow Seeds" Battle Action routines
ROM[0xC2C114] = {
	JSL (Enemy_Backup_Init_Enemy_Animation)
	
}

