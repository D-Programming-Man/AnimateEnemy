// Common code that updates the script's PC and returns
Parser_Common_Return: {
	REP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	
	LDA_d (PARSER_SCRIPT_PC_LO_ADDR)
	STA_x (AE_SCRIPT_PC_LO_OFFSET)
	
	LDA_d (PARSER_SCRIPT_PC_HI_ADDR)
	SEP (0x20)
	STA_x (AE_SCRIPT_PC_HI_OFFSET)
	
	REP (0x20)
	
	RTL
}

/*
	* TECHNICAL NOTES *
	-------------------

	In the same vein as movscr_codes.ccs, we will write this for enemy battle sprites
	* 0xA21C is the start of the enemy's battler data values 
	* 0xAAD6 holds the sprite's OAM data values

		1.1. SCRIPT CONTROL INSTRUCTIONS
		b_halt
		b_pause()
		b_pause_result
		b_pause_var0-2
		
		1.2. DATA MOVEMENT INSTRUCTIONS
		b_set_var0-2()
		b_set_result()
		b_rtovar0-2
		b_get_var0-2
		b_get_mem8(addr)
		b_get_mem16(addr)
		b_set_mem8(addr, value)
		b_set_mem16(addr, value)
		
		b_get_mem8_long(addr)
		b_get_mem8_var01
		b_set_mem8_var01(value)
		b_set_mem8_var01_result
		
		b_get_mem16_long(addr)
		b_get_mem16_var01
		b_set_mem16_var01(value)
		b_set_mem16_var01_result
		
		
		1.3. ARITHMETIC AND LOGICAL INSTRUCTIONS
		// add, and, or, xor	
		b_op_result(value)
		b_op_var0-2(value)
		b_op_mem8(addr, value)
		b_op_mem16(addr, value)
		
		b_op_result_var0-2
		b_op_var0-2_result
		b_op_mem8_result(addr)
		b_op_mem16_result(addr)
		b_op_mem8_var0-2(addr)
		b_op_mem16_var0-2(addr)
		
		1.4. CONTROL FLOW INSTRUCTIONS
		b_jmp(address)
		b_jml(address)
		b_multijmp(amount)
		b_jeq(address)
		b_jne(address)
		// b_jsr(address)
		// b_jsl(address)
		// m_multijsr(amount)
		// b_rts
		// b_rtl
		
		1.5. LOOP INSTRUCTIONS
		b_loop(count)
		b_loop_result
		m_endloop
		m_breakeq(address)
		m_breakne(address)
		
		1.6. TASK INSTRUCTIONS
		// b_task(address)
		// b_task_long(address)
		// b_endtask
		// b_endlasttask
		
		1.7. CALLBACK INSTRUCTIONS
		// b_ontick(address)
		// b_ontick_nop
		// b_ondraw(address)
		// b_onposition(address)
		// b_onmove(address)
		// b_ondestory(address)
		
		1.8. SPRITE INSTRUCTIONS
		// b_set_spritemap(address)
		b_set_anim(value)
		b_set_anim_var0-2
		b_add_anim(value)
		b_inc_anim
		b_dec_anim
		b_priority(value)
		b_set_xpos(value)
		b_set_ypos(value)
		// b_set_zpos(value)
		b_add_xpos(value)
		b_add_ypos(value)
		// b_add_zpos(value)
		// b_set_xvel(value)
		// b_set_yvel(value)
		// b_set_zvel(value)
		// b_add_xvel(value)
		// b_add_yvel(value)
		// b_add_zvel(value)
		// b_zerovel
		
		b_set_xpos_result
		b_set_xpos_var0-2
		b_add_xpos_result
		b_add_xpos_var0-2
		b_set_ypos_result
		b_set_ypos_var0-2
		b_add_ypos_result
		b_add_ypos_var0-2
		
		b_set_palette(value)
		b_set_palette_result
		b_set_palette_var0-2
		b_get_palette
		b_new_palette(address)
		b_new_palette_var01
		
		b_set_palette_cycle(0 or 1)
		b_set_palette_cycle_rate(value)
		b_set_palette_cycle_rate_result
		b_set_palette_cycle_rate_var0-2
		b_cycle_palette
		
		b_flip_horizontal(0 or 1)
		b_flip_vertical(0 or 1)
		
		1.9. OTHER INSTRUCTIONS
		b_end
		b_asmcall(address)
		b_store_result
		b_load_result
		
		
		
		
	struct AnimateEnemyList {
		AnimateEnemyEntry list[8]
		byte OAM_Scratch[80]
	} new_AnimateEnemyList = {[null x8]; [0x00 x 80]};
	
	struct AnimateEnemyEntry {
		short battler_addr;
		adr24 void* palette_addr;
		adr24 void* Script_PC;
		short result;
		short var0;
		short var1;
		short var2;
		byte base_xpos;
		byte base_ypos;
		byte current_frame;
		byte pause_frames;
		byte palette_cycle_rate;
		byte palette_cycle_cooldown;
		byte flying_height;
		byte flying_speed;
		byte flying_counter;
		byte attributes; 		// 0bVHPP CCCt
								//   |||| ||||
								//   |||| |||- HI OAM
								//   |||| ||-- Color (LO)
								//   |||| |--- Color (MED)
								//   |||| ---- Color (HI)
								//   ||||
								//   |||------ Priority Draw (LO)
								//   ||------- Priority Draw (HI) 
								//   |-------- Horizontal Flip
								//   --------- Vertical Flip
		
		
		byte setting_toggle;	// 0bKSFP H000
								//   |||| ||||
								//   |||| |||- 
								//   |||| ||-- 
								//   |||| |--- 
								//   |||| ---- Toggle Half Palette to Cycle
								//   ||||
								//   |||------ Toggle to Cycle Palettes
								//   ||------- Toggle Flying
								//   |-------- Soft toggle, enables/disables the script
								//   --------- Kill switch, turns the animation off (b_end)
		
		
	}
	
	https://snes.nesdev.org/wiki/Sprites
	struct OAM_Spritemap {
		byte y_pos;
		byte tile;	// size 32x32; 0xYX, Y = 8 pixel down, X = 8 pixel right
		byte attr;			// 0bVHPP CCCt
							// V = Vertical Flip
							// H = Horizontal Flip 
							// PP = Priority Draw
							// CCC = Palette ID on CGRAM
							// t = High bit of tile of OAM
							//		It's basically a bit that changes the 128x128 section of OAM
							//		to use either the lower or higher 128x128 sections of OAM
							// 		It makes sense if you were to add the tiles together since the
							//		carry bit of the addition goes to that "t" bit
		byte x_pos;
		byte toggle-size	// 0xTS
							// T (0x80 or 0x00) = Toggles drawing or stoping OAM draw tiles
							// S (0x00 or 0x01) = 16x16 or 32x32 sprite size	
	}
*/