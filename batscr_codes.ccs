	short Store_16bit_Value	// 0x46; Effective Speed (Turn order, higher = more priority)
	short Return	// 0x47
	short Store_8bit_Value	// 0x48; Blinking Invisible Timer (when enemies get damaged)
	short Store_8bit_Value	// 0x49; Blinking Black Timer 
