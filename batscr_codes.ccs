// Set the flying counter to a random 8bit value 
BYTECODE_6B: {
	LDA_i (0x00FF)
	JSL (RandModA)
	
	SEP (0x20)
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	STA_x (AE_SCRIPT_FLYING_COUNTER_OFFSET)

Return:
	JMP_l (Parser_Common_Return)
}

BYTECODE_6C: {
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_i (AE_SCRIPT_SETTINGS_USE_HALF_PALETTE_CYCLE_BIT)
	BEQ_a (Check_Palette_Cycle_Loop_Use_Full_Palette)
	
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	LSR
	STA_d (PARSER_TEMP_VAR_4)
	BRA_a (Check_Palette_Cycle_Loop_Init_2)
	
Check_Palette_Cycle_Loop_Use_Full_Palette:
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	STA_d (PARSER_TEMP_VAR_4)

Check_Palette_Cycle_Loop_Init_2:
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL)
	LSR
	TAY
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	JSL (Mul16x8r16)
	CLC
	ADC_i (OAM_NORMAL_ENEMY_PALETTE_ADDR)
	INC
	INC		// Start on the 1st palette color, the 0th is the transparency
	STA_d (PARSER_TEMP_VAR_1)
	TAX
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	LDY_i (0x0004)

Check_Palette_Cycle_Loop:
	CPY_i (PARSER_TEMP_VAR_4)
	BEQ_a (Check_Palette_Cycle_Loop_End)
	
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0002)
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	
	INX
	INX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
	INY
	INY
	
	BRA_a (Check_Palette_Cycle_Loop)
	
Check_Palette_Cycle_Loop_End:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_i (OAM_NORMAL_TO_DARK_PALETTE_DISTANCE)
	TAX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	LDY_i (0x0004)
	
Check_Dark_Palette_Cycle_Loop:
	CPY_i (PARSER_TEMP_VAR_4)
	BEQ_a (Return)
	
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0002)
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	
	INX
	INX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
	INY
	INY
	
	BRA_a (Check_Dark_Palette_Cycle_Loop)
	
Return:
	JMP_l (Parser_Common_Return)
}

BYTECODE_6D: {
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_i (AE_SCRIPT_SETTINGS_USE_HALF_PALETTE_CYCLE_BIT)
	BEQ_a (Check_Palette_Cycle_Loop_Use_Full_Palette)
	
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	LSR
	STA_d (PARSER_TEMP_VAR_4)
	BRA_a (Check_Palette_Cycle_Loop_Init_2)
	
Check_Palette_Cycle_Loop_Use_Full_Palette:
	LDA_i (0)
	STA_d (PARSER_TEMP_VAR_4)
	
Check_Palette_Cycle_Loop_Init_2:
	LDA_x (AE_SCRIPT_ATTRIBUTES_OFFSET)
	AND_i (AE_SCRIPT_ATTRIBUTES_PALETTE_ID_ALL)
	LSR
	TAY
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	JSL (Mul16x8r16)
	CLC
	ADC_i (OAM_NORMAL_ENEMY_PALETTE_ADDR)
	CLC
	ADC_i (OAM_ENEMY_PALETTE_SIZE)
	SEC
	SBC_d (PARSER_TEMP_VAR_4)
	DEC
	DEC
	DEC
	DEC		// Start on the 2nd to last palette color
	STA_d (PARSER_TEMP_VAR_1)
	TAX
	
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	SEC
	SBC_d (PARSER_TEMP_VAR_4)
	TAY
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	

Check_Palette_Cycle_Loop:
	CPY_i (0x0004)
	BEQ_a (Check_Palette_Cycle_Loop_End)
	
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0002)
	
	DEX
	DEX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
	DEY
	DEY
	
	BRA_a (Check_Palette_Cycle_Loop)
	
Check_Palette_Cycle_Loop_End:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_i (OAM_NORMAL_TO_DARK_PALETTE_DISTANCE)
	TAX
	
	LDA_i (OAM_ENEMY_PALETTE_SIZE)
	SEC
	SBC_d (PARSER_TEMP_VAR_4)
	TAY
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
Check_Dark_Palette_Cycle_Loop:
	CPY_i (0x0004)
	BEQ_a (Return)
	
	LDA_d (PARSER_TEMP_VAR_3)
	STA_x (0x0000)
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0002)
	
	DEX
	DEX
	
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_x (0x0002)
	STA_d (PARSER_TEMP_VAR_3)
	
	DEY
	DEY
	
	BRA_a (Check_Dark_Palette_Cycle_Loop)
	
Return:
	JMP_l (Parser_Common_Return)
}

BYTECODE_6E: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_SETTINGS_OFFSET)
	AND_i (AE_SCRIPT_SETTINGS_USE_HALF_PALETTE_CYCLE_BIT)
	LSR
	LSR
	LSR
	STA_d (PARSER_TEMP_VAR_1)
	
Store_Value:
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
