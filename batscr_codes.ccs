BYTECODE_57: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)

	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	STA_d (PARSER_TEMP_VAR_1)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	ASL
	CLC
	ADC_i (short[0] Load_Data_Addr_Table)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_i (short[1] Load_Data_Addr_Table)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_3)
	
	LDA_dl (PARSER_TEMP_VAR_2)
	STA_a (RAM_JUMP_LO_ADDR)
	
	JMP_i (RAM_JUMP_LO_ADDR)
	
Load_8bit_Value:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_d (PARSER_BYTE_CODE_PARAM_2)
	TAX
	LDA_x (0x0000)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_2)
	BRA_a (Store_Value)

Load_16bit_Value:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_d (PARSER_BYTE_CODE_PARAM_2)
	TAX
	LDA_x (0x0000)
	STA_d (PARSER_TEMP_VAR_2)

Store_Value:
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	TAX
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
	
Load_Data_Addr_Table:
	short Load_16bit_Value	// 0x00; Enemy Number
	short Return	// 0x01
	short Load_16bit_Value	// 0x02; Enemy Sprite
	short Return	// 0x03
	short Load_16bit_Value	// 0x04; Current Action
	short Return	// 0x05
	short Load_8bit_Value	// 0x06; Next Action (0-3 if sequential, 0-1 top bit if staggered)
	short Load_8bit_Value	// 0x07; Action Input
	short Load_16bit_Value	// 0x08; Action Input
	short Load_8bit_Value	// 0x09; Targetting Type
	short Load_8bit_Value	// 0x0A; Target
	short Load_8bit_Value	// 0x0B; Enemy Letters
	short Load_8bit_Value	// 0x0C; Batter Existance Boolean
	short Load_8bit_Value	// 0x0D; Battler Already Acted Boolean
	short Load_8bit_Value	// 0x0E; Battler Enemy Boolean
	short Load_8bit_Value	// 0x0F; NPC Number for Party (0 if not NPC)
	short Load_8bit_Value	// 0x10; Row ID / Character Number (PC)
	short Load_16bit_Value	// 0x11; Rolling HP (Only updated when checked)
	short Return	// 0x12
	short Load_16bit_Value	// 0x13; Current HP
	short Return	// 0x14
	short Load_16bit_Value	// 0x15; Max HP
	short Return	// 0x16
	short Load_16bit_Value	// 0x17; Rolling PP (Only updated when checked)
	short Return	// 0x18
	short Load_16bit_Value	// 0x19; Current PP
	short Return	// 0x1A
	short Load_16bit_Value	// 0x1B; Max PP
	short Return	// 0x1C
	short Load_8bit_Value	// 0x1D; Permanent Status
	short Load_8bit_Value	// 0x1E; Sprite Changing Status (Mushroomized/Possessed)
	short Load_8bit_Value	// 0x1F; Battle Status
	short Load_8bit_Value	// 0x20; Feeling Strange
	short Load_8bit_Value	// 0x21; Can't Concentrate (Turn Duration)
	short Load_8bit_Value	// 0x22; Homesickness
	short Load_8bit_Value	// 0x23; Sheild Type (1 = PSI beta, 2 = PSI alpha, 3 = beta, 4 = alpha)
	short Load_8bit_Value	// 0x24; Defending Boolean
	short Load_8bit_Value	// 0x25; Shield Duration
	short Load_8bit_Value	// 0x26; Offense 
	short Return	// 0x27
	short Load_16bit_Value	// 0x28; Defense
	short Return	// 0x29
	short Load_16bit_Value	// 0x2A; Speed
	short Return	// 0x2B
	short Load_16bit_Value	// 0x2C; Guts
	short Return	// 0x2D
	short Load_16bit_Value	// 0x2E; Luck
	short Return	// 0x2F
	short Load_8bit_Value	// 0x30; Vitality
	short Load_8bit_Value	// 0x31; IQ
	short Load_8bit_Value	// 0x32; Unmodified Offense
	short Load_8bit_Value	// 0x33; Unmodified Defense
	short Load_8bit_Value	// 0x34; Unmodified Speed
	short Load_8bit_Value	// 0x35; Unmodified Guts
	short Load_8bit_Value	// 0x36; Unmodified Luck
	short Load_8bit_Value	// 0x37; Paralysis / Diamondization Weakness
	short Load_8bit_Value	// 0x38; Freeze Weakness
	short Load_8bit_Value	// 0x39; Flash Weakness
	short Load_8bit_Value	// 0x3A; Fire Weakness
	short Load_8bit_Value	// 0x3B; Brainshock Weakness
	short Load_8bit_Value	// 0x3C; Hypnosis Weakness
	short Load_16bit_Value	// 0x3D; Money Gained in Battle
	short Return	// 0x3E
	short Load_16bit_Value	// 0x3F; EXP Gained in Battle
	short Return	// 0x40
	short Return	// 0x41
	short Return	// 0x42
	short Load_8bit_Value	// 0x43; OAM Spritemap ID used for 0xAAD6 and 0xAABE
	short Load_8bit_Value	// 0x44; X Position
	short Load_8bit_Value	// 0x45; Y Position
	short Load_16bit_Value	// 0x46; Effective Speed (Turn order, higher = more priority)
	short Return	// 0x47
	short Load_8bit_Value	// 0x48; Blinking Invisible Timer (when enemies get damaged)
	short Load_8bit_Value	// 0x49; Blinking Black Timer 
	short Load_8bit_Value	// 0x4A; Target for Attack Boolean (Blinks dark when target for attack)
	short Load_8bit_Value	// 0x4B; Darken Sprite Boolean (Turns sprite dark)
	short Load_16bit_Value	// 0x4C; Enemy ID for calling for back up
	short Return	// 0x4D
}


BYTECODE_58: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	STZ_d (PARSER_BYTE_CODE_PARAM_2)

	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_2)
	
	BAT_MACRO_LOAD_16BIT_PARAM(PARSER_BYTE_CODE_PARAM_3)

	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_BATTLER_ADDR)
	STA_d (PARSER_TEMP_VAR_1)

	LDA_d (PARSER_BYTE_CODE_PARAM_2)
	ASL
	CLC
	ADC_i (short[0] Load_Data_Addr_Table)
	STA_d (PARSER_TEMP_VAR_2)
	LDA_i (short[1] Load_Data_Addr_Table)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_3)
	
	LDA_dl (PARSER_TEMP_VAR_2)
	STA_a (RAM_JUMP_LO_ADDR)
	
	JMP_i (RAM_JUMP_LO_ADDR)
	
Store_8bit_Value:
	LDY_d (PARSER_BYTE_CODE_PARAM_1)
	CPY_i (0x00FF)
	BNE_a (Store_8bit_Register)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_2)
	
	BRA_a (Store_8bit)
	
Store_8bit_Register:
	BAT_MACRO_8BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	STA_d (PARSER_TEMP_VAR_2)

Store_8bit:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_d (PARSER_BYTE_CODE_PARAM_2)
	TAX
	
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0000)
	
	BRA_a (Return)

Store_16bit_Value:
	LDY_d (PARSER_BYTE_CODE_PARAM_1)
	CPY_i (0x00FF)
	BNE_a (Store_16bit_Register)
	
	LDA_d (PARSER_BYTE_CODE_PARAM_3)
	STA_d (PARSER_TEMP_VAR_2)
	
	BRA_a (Store_8bit)
	
Store_16bit_Register:
	BAT_MACRO_16BIT_AE_GET_DATA_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	STA_d (PARSER_TEMP_VAR_2)

Store_16bit:
	LDA_d (PARSER_TEMP_VAR_1)
	CLC
	ADC_d (PARSER_BYTE_CODE_PARAM_2)
	TAX
	
	LDA_d (PARSER_TEMP_VAR_2)
	STA_x (0x0000)

Return:
	JMP_l (Parser_Common_Return)

Load_Data_Addr_Table:
	short Store_16bit_Value	// 0x00; Enemy Number
	short Return	// 0x01
	short Store_16bit_Value	// 0x02; Enemy Sprite
	short Return	// 0x03
	short Store_16bit_Value	// 0x04; Current Action
	short Return	// 0x05
	short Store_8bit_Value	// 0x06; Next Action (0-3 if sequential, 0-1 top bit if staggered)
	short Store_8bit_Value	// 0x07; Action Input
	short Store_16bit_Value	// 0x08; Action Input
	short Store_8bit_Value	// 0x09; Targetting Type
	short Store_8bit_Value	// 0x0A; Target
	short Store_8bit_Value	// 0x0B; Enemy Letters
	short Store_8bit_Value	// 0x0C; Batter Existance Boolean
	short Store_8bit_Value	// 0x0D; Battler Already Acted Boolean
	short Store_8bit_Value	// 0x0E; Battler Enemy Boolean
	short Store_8bit_Value	// 0x0F; NPC Number for Party (0 if not NPC)
	short Store_8bit_Value	// 0x10; Row ID / Character Number (PC)
	short Store_16bit_Value	// 0x11; Rolling HP (Only updated when checked)
	short Return	// 0x12
	short Store_16bit_Value	// 0x13; Current HP
	short Return	// 0x14
	short Store_16bit_Value	// 0x15; Max HP
	short Return	// 0x16
	short Store_16bit_Value	// 0x17; Rolling PP (Only updated when checked)
	short Return	// 0x18
	short Store_16bit_Value	// 0x19; Current PP
	short Return	// 0x1A
	short Store_16bit_Value	// 0x1B; Max PP
	short Return	// 0x1C
	short Store_8bit_Value	// 0x1D; Permanent Status
	short Store_8bit_Value	// 0x1E; Sprite Changing Status (Mushroomized/Possessed)
	short Store_8bit_Value	// 0x1F; Battle Status
	short Store_8bit_Value	// 0x20; Feeling Strange
	short Store_8bit_Value	// 0x21; Can't Concentrate (Turn Duration)
	short Store_8bit_Value	// 0x22; Homesickness
	short Store_8bit_Value	// 0x23; Sheild Type (1 = PSI beta, 2 = PSI alpha, 3 = beta, 4 = alpha)
	short Store_8bit_Value	// 0x24; Defending Boolean
	short Store_8bit_Value	// 0x25; Shield Duration
	short Store_8bit_Value	// 0x26; Offense 
	short Return	// 0x27
	short Store_16bit_Value	// 0x28; Defense
	short Return	// 0x29
	short Store_16bit_Value	// 0x2A; Speed
	short Return	// 0x2B
	short Store_16bit_Value	// 0x2C; Guts
	short Return	// 0x2D
	short Store_16bit_Value	// 0x2E; Luck
	short Return	// 0x2F
	short Store_8bit_Value	// 0x30; Vitality
	short Store_8bit_Value	// 0x31; IQ
	short Store_8bit_Value	// 0x32; Unmodified Offense
	short Store_8bit_Value	// 0x33; Unmodified Defense
	short Store_8bit_Value	// 0x34; Unmodified Speed
	short Store_8bit_Value	// 0x35; Unmodified Guts
	short Store_8bit_Value	// 0x36; Unmodified Luck
	short Store_8bit_Value	// 0x37; Paralysis / Diamondization Weakness
	short Store_8bit_Value	// 0x38; Freeze Weakness
	short Store_8bit_Value	// 0x39; Flash Weakness
	short Store_8bit_Value	// 0x3A; Fire Weakness
	short Store_8bit_Value	// 0x3B; Brainshock Weakness
	short Store_8bit_Value	// 0x3C; Hypnosis Weakness
	short Store_16bit_Value	// 0x3D; Money Gained in Battle
	short Return	// 0x3E
