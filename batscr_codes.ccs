// Gets the current frame of the enemy and returns it to the registers
BYTECODE_30: {
	STZ_d (PARSER_BYTE_CODE_PARAM_1)
	
	BAT_MACRO_LOAD_8BIT_PARAM(PARSER_BYTE_CODE_PARAM_1)
	
	LDX_d (PARSER_ANIMATE_ENEMY_ENTRY_ADDR)
	LDA_x (AE_SCRIPT_CURRENT_FRAME_OFFSET)
	AND_i (0x00FF)
	STA_d (PARSER_TEMP_VAR_1)
	
	BAT_MACRO_AE_GET_OFFSET_ADDR_USING_PARAM(PARSER_BYTE_CODE_PARAM_1, AE_SCRIPT_RESULT_OFFSET)
	TAX
	STA_x (0x0000)
	
Return:
	JMP_l (Parser_Common_Return)
}


BYTECODE_31: {
